generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(cuid())
  name              String
  username          String   @unique
  password          String
  role              String   @default("PHYSICIAN")   // "ADMIN" | "PHYSICIAN"
  isPRN             Boolean  @default(false)
  prefersTwelveHour Boolean  @default(false)
  isActive          Boolean  @default(true)
  adminTargetShifts Int?     // admin-set shift target (overrides physician's if set)
  adminHardCap      Boolean  @default(false)  // if true, scheduler never exceeds adminTargetShifts
  createdAt         DateTime @default(now())

  preferences      PhysicianPreference[]
  blockedDates     BlockedDate[]
  preferredDates   PreferredDate[]
  assignments      ShiftAssignment[]
  offeredShifts    ShiftOffer[] @relation("OfferedShifts")
  targetedTrades   ShiftOffer[] @relation("TargetedTrades")
  pickupRequests   ShiftOffer[] @relation("PickupRequests")
}

model SchedulePeriod {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  status      String   @default("DRAFT")  // DRAFT | OPEN | GENERATING | PUBLISHED
  maxDayOff   Int?
  fcfsEnabled Boolean  @default(false)
  createdAt   DateTime @default(now())

  preferences    PhysicianPreference[]
  assignments    ShiftAssignment[]
  preferredDates PreferredDate[]

  @@unique([month, year])
}

model PhysicianPreference {
  id           String    @id @default(cuid())
  userId       String
  periodId     String
  targetShifts Int       @default(15)
  minShifts    Int?      // minimum they'll accept
  maxShifts    Int?      // maximum they'll accept
  notes        String?
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User           @relation(fields: [userId], references: [id])
  period SchedulePeriod @relation(fields: [periodId], references: [id])

  @@unique([userId, periodId])
}

model BlockedDate {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  type      String   @default("VACATION")   // VACATION | PERSONAL | OTHER
  hardness  String   @default("REQUIRED")   // "REQUIRED" | "PREFERRED"
  note      String?
  status    String   @default("CONFIRMED")  // CONFIRMED | WAITLISTED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ShiftAssignment {
  id           String   @id @default(cuid())
  periodId     String
  userId       String?
  date         String   // "YYYY-MM-DD" (shift start date)
  shiftType    String   // "24H" | "DAY12" | "NIGHT12"
  isLocked     Boolean  @default(false)
  isConflict   Boolean  @default(false)
  conflictNote String?
  createdAt    DateTime @default(now())

  period           SchedulePeriod @relation(fields: [periodId], references: [id])
  user             User?          @relation(fields: [userId], references: [id])
  offer            ShiftOffer?    @relation("OfferedAssignment")
  tradeTargetOffer ShiftOffer?    @relation("TradeTargetAssignment")
}

model ShiftOffer {
  id                 String           @id @default(cuid())
  type               String           // "PICKUP" | "TRADE"
  status             String           @default("PENDING") // "PENDING" | "ACCEPTED" | "CANCELLED" | "COMPLETED" | "DENIED"
  offeringUserId     String
  offeringUser       User             @relation("OfferedShifts", fields: [offeringUserId], references: [id])
  assignmentId       String           @unique
  assignment         ShiftAssignment  @relation("OfferedAssignment", fields: [assignmentId], references: [id])
  targetUserId       String?
  targetUser         User?            @relation("TargetedTrades", fields: [targetUserId], references: [id])
  targetAssignmentId String?          @unique
  targetAssignment   ShiftAssignment? @relation("TradeTargetAssignment", fields: [targetAssignmentId], references: [id])
  requestedByUserId  String?
  requestedByUser    User?            @relation("PickupRequests", fields: [requestedByUserId], references: [id])
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AdminSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model PreferredDate {
  id        String   @id @default(cuid())
  userId    String
  periodId  String
  date      String   // "YYYY-MM-DD"
  shiftType String?  // "24H" | "DAY12" | "NIGHT12" | null (= any)
  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id])
  period SchedulePeriod @relation(fields: [periodId], references: [id])

  @@unique([userId, periodId, date])
}
